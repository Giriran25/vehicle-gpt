# Local development default. For multi-user production, use PostgreSQL.
DATABASE_URL=sqlite:///./vehiclegpt.db
APP_ENV=development
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vehiclegpt
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
