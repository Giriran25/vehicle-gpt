# Local development default. For multi-user production, use PostgreSQL.
DATABASE_URL=sqlite:///./vehiclegpt.db
APP_ENV=development
SEED_DEMO_DATA=true
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host.example.com/vehiclegpt?sslmode=require
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
